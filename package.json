{
  "name": "cleandub",
  "version": "1.0.1",
  "description": "CleanDub - Duplicate file cleaner desktop app (Electron + React + TypeScript)",
  "private": true,
  "main": "electron/main.js",
  "author": "CleanDub",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && set NODE_ENV=development&& electron .",
    "start": "electron .",
    "test": "node electron/smoke.test.js && node electron/smoke.options.test.js && node electron/smoke.quarantine.test.js",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "electron-builder --win",
    "package": "electron-builder --win --dir"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}